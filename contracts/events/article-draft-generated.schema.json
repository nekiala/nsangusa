{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/article-draft-generated.schema.json",
  "title": "ArticleDraftGenerated",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ArticleDraftGenerated"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storyCandidateId",
            "headline",
            "summary",
            "body",
            "seoTitle",
            "seoDescription",
            "slugSuggestion",
            "tags",
            "topic",
            "sources",
            "claims",
            "confidence",
            "uncertaintyNotes",
            "safetyFlags",
            "humanReviewRequired",
            "imagePrompt",
            "imageAltText",
            "socialPreviewText",
            "provider",
            "model",
            "promptVersion",
            "generatedAt"
          ],
          "properties": {
            "storyCandidateId": {
              "type": "string",
              "format": "uuid"
            },
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30000,
              "pattern": "\\S"
            },
            "editorialContext": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 5000
            },
            "seoTitle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            "seoDescription": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "slugSuggestion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250,
              "pattern": "\\S"
            },
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50,
                "pattern": "\\S"
              }
            },
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "common.schema.json#/$defs/sourceReference"
              }
            },
            "claims": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "$ref": "common.schema.json#/$defs/claim"
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "uncertaintyNotes": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              }
            },
            "safetyFlags": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              }
            },
            "humanReviewRequired": {
              "type": "boolean"
            },
            "imagePrompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "imageAltText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "socialPreviewText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "promptVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "language": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "fr",
                "en",
                null
              ]
            },
            "translations": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "language",
                  "headline",
                  "summary",
                  "body",
                  "seoTitle",
                  "seoDescription",
                  "imageAltText"
                ],
                "properties": {
                  "language": {
                    "type": "string",
                    "enum": [
                      "fr",
                      "en"
                    ]
                  },
                  "headline": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "pattern": "\\S"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30000,
                    "pattern": "\\S"
                  },
                  "editorialContext": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 5000
                  },
                  "seoTitle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "pattern": "\\S"
                  },
                  "seoDescription": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "\\S"
                  },
                  "imageAltText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

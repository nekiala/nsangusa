{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/article-draft-generated.schema.json",
  "title": "ArticleDraftGenerated",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ArticleDraftGenerated"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storyCandidateId",
            "headline",
            "summary",
            "body",
            "seoTitle",
            "seoDescription",
            "slugSuggestion",
            "tags",
            "topic",
            "sources",
            "claims",
            "confidence",
            "uncertaintyNotes",
            "safetyFlags",
            "humanReviewRequired",
            "imagePrompt",
            "imageAltText",
            "socialPreviewText",
            "provider",
            "model",
            "promptVersion",
            "generatedAt"
          ],
          "properties": {
            "storyCandidateId": {
              "type": "string",
              "format": "uuid"
            },
            "headline": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "editorialContext": {
              "type": ["string", "null"]
            },
            "seoTitle": {
              "type": "string",
              "minLength": 1
            },
            "seoDescription": {
              "type": "string",
              "minLength": 1
            },
            "slugSuggestion": {
              "type": "string",
              "minLength": 1
            },
            "tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "topic": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/sourceReference"
              }
            },
            "claims": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/claim"
              }
            },
            "confidence": {
              "type": "number"
            },
            "uncertaintyNotes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "safetyFlags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "humanReviewRequired": {
              "type": "boolean"
            },
            "imagePrompt": {
              "type": "string",
              "minLength": 1
            },
            "imageAltText": {
              "type": "string",
              "minLength": 1
            },
            "socialPreviewText": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "promptVersion": {
              "type": "string",
              "minLength": 1
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/article-draft-requested.schema.json",
  "title": "ArticleDraftRequested",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ArticleDraftRequested"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storyCandidateId", "sources", "analysis", "claims", "confidence", "warnings"],
          "properties": {
            "storyCandidateId": {
              "type": "string",
              "format": "uuid"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/sourceReference"
              }
            },
            "analysis": {
              "type": "string",
              "minLength": 1
            },
            "claims": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/claim"
              }
            },
            "confidence": {
              "type": "number"
            },
            "warnings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}


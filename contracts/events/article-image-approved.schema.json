{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/article-image-approved.schema.json",
  "title": "ArticleImageApproved",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ArticleImageApproved"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "articleId",
            "generationId",
            "objectKey",
            "altText",
            "approvedBy",
            "approvedAt"
          ],
          "properties": {
            "articleId": {
              "type": "string",
              "format": "uuid"
            },
            "generationId": {
              "type": "string",
              "format": "uuid"
            },
            "objectKey": {
              "type": "string",
              "minLength": 1
            },
            "altText": {
              "type": "string",
              "minLength": 1
            },
            "approvedBy": {
              "type": "string",
              "format": "uuid"
            },
            "approvedAt": {
              "type": "string",
              "format": "date-time"
            },
            "generatedImage": {
              "type": ["boolean", "null"],
              "description": "Whether the approved image was AI-generated. Absent or null means true for legacy events; false identifies an explicitly selected original editorial fallback."
            }
          }
        }
      }
    }
  ]
}

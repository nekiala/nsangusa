            "generationId",
            "objectKey",
            "altText",
            "provider",
            "model",
            "generatedAt"
          ],
          "properties": {
            "articleId": {
              "type": "string",
              "format": "uuid"
            },
            "generationId": {
              "type": "string",
              "format": "uuid"
            },
            "objectKey": {
              "type": "string",
              "minLength": 1
            },
            "altText": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}

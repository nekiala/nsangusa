{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/article-image-generated.schema.json",
  "title": "ArticleImageGenerated",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ArticleImageGenerated"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["articleId", "objectKey", "altText", "provider", "model", "generatedAt"],
          "properties": {
            "articleId": {
              "type": "string",
              "format": "uuid"
            },
            "generationId": {
              "type": ["string", "null"],
              "format": "uuid"
            },
            "objectKey": {
              "type": "string",
              "minLength": 1
            },
            "altText": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/article-image-requested.schema.json",
  "title": "ArticleImageRequested",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ArticleImageRequested"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["articleId", "prompt", "altText"],
          "properties": {
            "articleId": {
              "type": "string",
              "format": "uuid"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "altText": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}


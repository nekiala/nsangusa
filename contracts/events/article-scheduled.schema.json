{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/article-scheduled.schema.json",
  "title": "ArticleScheduled",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ArticleScheduled"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "articleId",
            "scheduleId",
            "publishAt",
            "articleVersion",
            "scheduledBy"
          ],
          "properties": {
            "articleId": {
              "type": "string",
              "format": "uuid"
            },
            "scheduleId": {
              "type": "string",
              "format": "uuid"
            },
            "publishAt": {
              "type": "string",
              "format": "date-time"
            },
            "articleVersion": {
              "type": "integer",
              "minimum": 0
            },
            "scheduledBy": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  ]
}

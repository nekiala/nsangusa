{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/comment-submitted.schema.json",
  "title": "CommentSubmitted",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "CommentSubmitted"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commentId", "articleId", "authorId"],
          "properties": {
            "commentId": {
              "type": "string",
              "format": "uuid"
            },
            "articleId": {
              "type": "string",
              "format": "uuid"
            },
            "authorId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  ]
}


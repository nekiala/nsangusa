{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/newsletter-delivery-failed.schema.json",
  "title": "NewsletterDeliveryFailed",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "NewsletterDeliveryFailed"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deliveryId",
            "articleId",
            "campaignKey",
            "failureCode",
            "reconciliationRequired",
            "failedAt"
          ],
          "properties": {
            "deliveryId": {
              "type": "string",
              "format": "uuid"
            },
            "articleId": {
              "type": "string",
              "format": "uuid"
            },
            "campaignKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "failureCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "reconciliationRequired": {
              "type": "boolean"
            },
            "failedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}

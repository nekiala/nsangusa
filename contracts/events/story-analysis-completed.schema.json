{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/story-analysis-completed.schema.json",
  "title": "StoryAnalysisCompleted",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "StoryAnalysisCompleted"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storyCandidateId",
            "confidence",
            "claimCount",
            "warnings",
            "provider",
            "model",
            "promptVersion",
            "completedAt"
          ],
          "properties": {
            "storyCandidateId": {
              "type": "string",
              "format": "uuid"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "claimCount": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              }
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "promptVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/story-analysis-requested.schema.json",
  "title": "StoryAnalysisRequested",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "StoryAnalysisRequested"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storyCandidateId", "sources", "sourceMaterial"],
          "properties": {
            "storyCandidateId": {
              "type": "string",
              "format": "uuid"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "common.schema.json#/$defs/sourceReference"
              }
            },
            "sourceMaterial": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60000,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nsangusa.invalid/events/x-post-normalized.schema.json",
  "title": "XPostNormalized",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "XPostNormalized"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourcePostId", "postId", "handle", "canonicalUrl", "normalizedText", "publishedAt", "topics"],
          "properties": {
            "sourcePostId": {
              "type": "string",
              "format": "uuid"
            },
            "postId": {
              "type": "string",
              "minLength": 1
            },
            "handle": {
              "type": "string",
              "minLength": 1
            },
            "canonicalUrl": {
              "type": "string",
              "format": "uri"
            },
            "normalizedText": {
              "type": "string",
              "minLength": 1
            },
            "publishedAt": {
              "type": "string",
              "format": "date-time"
            },
            "topics": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}


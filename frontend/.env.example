NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-runtime publication origin for canonicals, OG/JSON-LD, robots, RSS and sitemaps.
# Exact HTTP(S) origin; empty preserves the NEXT_PUBLIC_SITE_URL build-time fallback.
PUBLIC_BASE_URL=
NEXT_PUBLIC_PUBLICATION_NAME=Nsangusa
# Build-time: empty uses the same-origin API proxy; otherwise use an exact HTTP(S) origin
# without paths/wildcards, with matching backend CORS/cookies. Also allowlisted by the HTML CSP.
NEXT_PUBLIC_API_URL=
# "api" is the production default. Set "fake" only for local demos and automated UI tests.
NEXT_PUBLIC_API_MODE=api
# Runtime-only exact HTTP(S) backend origin for server rendering and the same-origin /api/v1 proxy.
# A running container may change this without rebuilding; do not supply a path or credentials.
NSANGUSA_API_URL=http://localhost:8080
# Server-only public policy details. Leave approval empty until the publisher approves the exact copy.
PUBLICATION_PUBLISHER=
PUBLICATION_CONTACT_EMAIL=
PUBLICATION_PRIVACY_EMAIL=
PUBLICATION_JURISDICTION=
PUBLICATION_RETENTION_SUMMARY=
PUBLICATION_POLICY_EFFECTIVE_DATE=
# Current template: 2026-09-v1. Setting this is an operator attestation, not legal certification.
PUBLICATION_POLICY_APPROVED_VERSION=

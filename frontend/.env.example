NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLICATION_NAME=Nsangusa
# Browser-visible API origin. Use the same site as the frontend in production where possible.
NEXT_PUBLIC_API_URL=http://localhost:8080
# "api" is the production default. Set "fake" only for local demos and automated UI tests.
NEXT_PUBLIC_API_MODE=api
# Server-rendered public requests use this when it differs from the browser origin.
NSANGUSA_API_URL=http://localhost:8080

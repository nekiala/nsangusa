{
  "name": "nsangusa-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:runtime-proxy": "PUBLIC_BASE_URL= NEXT_PUBLIC_SITE_URL=http://build-time.invalid:3000 NEXT_PUBLIC_API_URL= NEXT_PUBLIC_API_MODE=api NSANGUSA_API_URL=http://build-time.invalid:8080 NEXT_DIST_DIR=.next-runtime-proxy npm run build && vitest run --config=vitest.runtime.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test --config=playwright.fullstack.config.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "jsdom": "27.1.0",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vitest": "4.0.8"
  }
}

{
  "uid": "nsangusa-operations",
  "title": "Nsangusa operations — provisional qualification",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["nsangusa", "provisional"],
  "timezone": "utc",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "links": [{"title": "Runbooks / limits", "url": "docs/reliability-operations.md", "type": "link"}],
  "templating": {"list": [
    {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "label": "Prometheus"},
    {"name": "namespace", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values(up{job=\"nsangusa-backend\"}, namespace)", "includeAll": true, "allValue": ".*", "refresh": 1}
  ]},
  "panels": [
    {"id": 1, "type": "text", "title": "Qualification boundary", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3}, "options": {"mode": "markdown", "content": "Database inventories are **gauges**, aggregated with max across replicas. Missing/stale data is not success. Targets are provisional; delivered inventory is not a delivery SLO. AI counters reset per process and pricing must be configured. Broker offsets, SMTP outcomes and managed-service health need external exporters/evidence."}},
    {"id": 2, "type": "timeseries", "title": "Public article error ratio (5m / 1h)", "gridPos": {"x": 0, "y": 3, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "nsangusa:public_errors:ratio5m{namespace=~\"$namespace\"}", "legendFormat": "{{namespace}} 5m"}, {"refId": "B", "expr": "nsangusa:public_errors:ratio1h{namespace=~\"$namespace\"}", "legendFormat": "{{namespace}} 1h"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Public article p95 seconds", "gridPos": {"x": 12, "y": 3, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (namespace,le) (rate(http_server_requests_seconds_bucket{job=\"nsangusa-backend\",namespace=~\"$namespace\",method=\"GET\",uri=~\"/api/v1/articles.*\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "Oldest committed outbox age / scheduled publication delay", "gridPos": {"x": 0, "y": 10, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "max by(namespace) (news_operations_outbox_oldest_age_seconds{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} outbox"}, {"refId": "B", "expr": "max by(namespace) (news_operations_publication_oldest_age_seconds{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} publication"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 5, "type": "timeseries", "title": "Outbox / failed event / moderation inventory", "gridPos": {"x": 12, "y": 10, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "max by(namespace) (news_operations_outbox_pending{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} outbox"}, {"refId": "B", "expr": "max by(namespace) (news_operations_failures_pending{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} failures"}, {"refId": "C", "expr": "max by(namespace) (news_operations_moderation_pending{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} moderation"}]},
    {"id": 6, "type": "timeseries", "title": "X accounts: failed / rate-limited / never synced", "gridPos": {"x": 0, "y": 17, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "max by(namespace) (news_operations_ingestion_failed_accounts{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} failed"}, {"refId": "B", "expr": "max by(namespace) (news_operations_ingestion_rate_limited_accounts{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} rate-limited"}, {"refId": "C", "expr": "max by(namespace) (news_operations_ingestion_never_synced_accounts{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} never synced"}]},
    {"id": 7, "type": "timeseries", "title": "AI operations / outcomes per second", "gridPos": {"x": 12, "y": 17, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "sum by(operation,outcome) (rate(news_ai_provider_calls_total{job=\"nsangusa-backend\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "{{operation}} {{outcome}}"}]},
    {"id": 8, "type": "timeseries", "title": "AI estimated spend (USD/hour, configured token prices only)", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "sum by(provider,model) (rate(news_ai_estimated_cost_usd_total{job=\"nsangusa-backend\",namespace=~\"$namespace\"}[$__rate_interval])) * 3600", "legendFormat": "{{provider}} {{model}}"}], "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []}},
    {"id": 9, "type": "timeseries", "title": "Database pool active / maximum / waiting", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "hikaricp_connections_active{job=\"nsangusa-backend\",namespace=~\"$namespace\"}", "legendFormat": "{{instance}} active"}, {"refId": "B", "expr": "hikaricp_connections_max{job=\"nsangusa-backend\",namespace=~\"$namespace\"}", "legendFormat": "{{instance}} max"}, {"refId": "C", "expr": "hikaricp_connections_pending{job=\"nsangusa-backend\",namespace=~\"$namespace\"}", "legendFormat": "{{instance}} waiting"}]},
    {"id": 10, "type": "timeseries", "title": "Newsletter delivered inventory / pending / reconciliation (not send rate)", "gridPos": {"x": 0, "y": 31, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "max by(namespace) (news_operations_newsletter_delivered{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} delivered"}, {"refId": "B", "expr": "max by(namespace) (news_operations_newsletter_pending{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} pending"}, {"refId": "C", "expr": "max by(namespace) (news_operations_newsletter_reconciliation{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} reconciliation"}]},
    {"id": 11, "type": "timeseries", "title": "Inventory snapshot age / collection success", "gridPos": {"x": 12, "y": 31, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "time() - news_operations_snapshot_timestamp_seconds{job=\"nsangusa-backend\",namespace=~\"$namespace\"}", "legendFormat": "{{instance}} age seconds"}, {"refId": "B", "expr": "news_operations_collection_success{job=\"nsangusa-backend\",namespace=~\"$namespace\"}", "legendFormat": "{{instance}} successful (0/1)"}]},
    {"id": 12, "type": "timeseries", "title": "JVM memory used / committed by replica", "gridPos": {"x": 0, "y": 38, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "sum by(instance,area) (jvm_memory_used_bytes{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{instance}} {{area}} used"}, {"refId": "B", "expr": "sum by(instance,area) (jvm_memory_committed_bytes{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{instance}} {{area}} committed"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"id": 13, "type": "timeseries", "title": "Process CPU utilization by replica", "gridPos": {"x": 12, "y": 38, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "process_cpu_usage{job=\"nsangusa-backend\",namespace=~\"$namespace\"}", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
    {"id": 14, "type": "timeseries", "title": "Oldest pending AI request / last successful ingestion age", "gridPos": {"x": 0, "y": 45, "w": 24, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "max by(namespace) (news_operations_ai_oldest_age_seconds{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} AI request"}, {"refId": "B", "expr": "max by(namespace) (news_operations_ingestion_oldest_age_seconds{job=\"nsangusa-backend\",namespace=~\"$namespace\"})", "legendFormat": "{{namespace}} X last success"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}}
  ]
}

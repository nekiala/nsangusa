{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "monitoring": {
      "type": "object",
      "required": ["enabled", "port", "namespaceSelector", "podSelector", "serviceMonitor", "prometheusRule", "grafana"],
      "properties": {
        "enabled": {"type": "boolean"},
        "runbookUrl": {
          "type": "string",
          "pattern": "^(docs/reliability-operations\\.md|https://[^\\s\"<>]+)$"
        },
        "port": {"type": "integer", "const": 8081},
        "namespaceSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "podSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
            "additionalLabels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "additionalLabels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "grafana": {
          "type": "object",
          "properties": {"sidecarLabel": {"type": "string"}}
        }
      }
    },
    "global": {
      "type": "object",
      "required": ["environment"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["development", "test", "staging", "production"]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "secret": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "backend": {
      "$ref": "#/$defs/workload"
    },
    "frontend": {
      "$ref": "#/$defs/workload"
    },
    "migration": {
      "type": "object",
      "required": ["enabled", "args"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "host", "backendPaths", "tls"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "backendPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "tls": {
          "type": "object",
          "required": ["enabled", "secretName"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "externalEgressManagedExternally",
        "backendExternalEgress",
        "frontendExternalEgress",
        "otelExternalEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalEgressManagedExternally": {
          "type": "boolean"
        },
        "backendExternalEgress": {
          "$ref": "#/$defs/egressRules"
        },
        "frontendExternalEgress": {
          "$ref": "#/$defs/egressRules"
        },
        "otelExternalEgress": {
          "$ref": "#/$defs/egressRules"
        }
      }
    },
    "otelCollector": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "replicaCount",
        "image",
        "resources",
        "autoscaling",
        "pdb"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        },
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "pdb": {
          "type": "object",
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+%$"
                }
              ]
            }
          }
        }
      }
    },
    "egressRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cidr", "ports"],
        "properties": {
          "cidr": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"
          },
          "except": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "protocol": {
                  "type": "string",
                  "enum": ["TCP", "UDP", "SCTP"]
                },
                "port": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}

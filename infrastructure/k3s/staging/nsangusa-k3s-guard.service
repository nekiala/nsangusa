[Unit]
Description=Restrict Nsangusa Kubernetes listeners on the shared staging host
Documentation=https://docs.k3s.io/security/hardening-guide
Wants=network-online.target
Before=k3s.service
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/nft --check --file /etc/nsangusa-k3s/guard.nft
ExecStart=/usr/sbin/nft --file /etc/nsangusa-k3s/guard.nft
ExecReload=/usr/sbin/nft --check --file /etc/nsangusa-k3s/guard.nft
ExecReload=/usr/sbin/nft --file /etc/nsangusa-k3s/guard.nft

[Install]
WantedBy=multi-user.target
